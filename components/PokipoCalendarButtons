    enddt: "2026-10-27T16:00:00+09:00",
    location: LOCATION,
    body: DETAILS,
  }).toString();

function escapeIcs(value: string): string {
  return value
    .replace(/\\/g, "\\\\")
    .replace(/\r?\n/g, "\\n")
    .replace(/,/g, "\\,")
    .replace(/;/g, "\\;");
}

function createIcs(): string {
  // Fixed UTC instants avoid device-timezone drift.
  return [
    "BEGIN:VCALENDAR",
    "VERSION:2.0",
    "PRODID:-//LiPost//POKIPO Calendar//JA",
    "CALSCALE:GREGORIAN",
    "METHOD:PUBLISH",
    "BEGIN:VEVENT",
    "UID:pokipo-reward-exchange-20261027@pokipo.vercel.app",
    "DTSTAMP:20261021T000000Z",
    `DTSTART:${START_UTC}`,
    `DTEND:${END_UTC}`,
    `SUMMARY:${escapeIcs(TITLE)}`,
    `LOCATION:${escapeIcs(LOCATION)}`,
    `DESCRIPTION:${escapeIcs(DETAILS)}`,
    "BEGIN:VALARM",
    "ACTION:DISPLAY",
    "DESCRIPTION:POKIPO 特典交換会のご案内",
    "TRIGGER:-PT60M",
    "END:VALARM",
    "END:VEVENT",
    "END:VCALENDAR",
    "",
  ].join("\r\n");
}

type Props = {
  testMode?: boolean;
};

export default function PokipoCalendarButtons({ testMode = false }: Props) {
  const [feedback, setFeedback] = useState("");

  function downloadIcs() {
    const blob = new Blob(["\uFEFF", createIcs()], {
      type: "text/calendar;charset=utf-8",
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "POKIPO_特典交換会_2026-10-27.ics";
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 2000);
    setFeedback("予定ファイルを保存しました。端末のカレンダーアプリで開いて登録してください。");
  }

  return (
    <section className="pokipoCalendarSection" aria-label="特典交換会をカレンダーに登録">
      <p className="pokipoCalendarEyebrow">SAVE THE DATE</p>
      <h3>特典交換会をカレンダーに登録</h3>
      <p className="pokipoCalendarSchedule">2026年10月27日（火）12:35〜16:00</p>
      <p className="pokipoCalendarLocation">獨協大学・雄飛ホール</p>
      {testMode && (
        <p className="pokipoCalendarTestNote">
          検証画面です。登録される予定は本番の特典交換会の日程です。
        </p>
      )}
      <div className="pokipoCalendarActions">
        <a href={GOOGLE_URL} target="_blank" rel="noopener noreferrer">
          Google カレンダー
        </a>
        <a href={OUTLOOK_URL} target="_blank" rel="noopener noreferrer">
          Outlook
        </a>
        <button type="button" onClick={downloadIcs}>
          Apple・その他（.ics）
        </button>
      </div>
      <p className="pokipoCalendarHelp">
        保存・登録を確定する操作は、各カレンダーアプリで行ってください。
      </p>
      {feedback && <p className="pokipoCalendarFeedback" role="status">{feedback}</p>}
      <style jsx>{`
        .pokipoCalendarSection{margin-top:18px;padding:20px 16px;border-radius:18px;background:#fff9f5;border:1px solid #f7d6cf;text-align:center;color:#35303a}
        .pokipoCalendarEyebrow{margin:0 0 5px;color:#d43d44;font-size:11px;font-weight:800;letter-spacing:.12em}
        .pokipoCalendarSection h3{margin:0 0 10px;font-size:18px;line-height:1.45}
        .pokipoCalendarSchedule{margin:0;font-size:15px;font-weight:800}
        .pokipoCalendarLocation{margin:4px 0 12px;font-size:13px}
        .pokipoCalendarTestNote{padding:8px;background:#fff0d3;border-radius:8px;font-size:12px;line-height:1.5}
        .pokipoCalendarActions{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
        .pokipoCalendarActions a,.pokipoCalendarActions button{display:flex;align-items:center;justify-content:center;min-height:46px;padding:9px 10px;border-radius:12px;border:1px solid #e9aaab;background:#fff;color:#ba283c;font:inherit;font-size:13px;font-weight:800;text-align:center;text-decoration:none;cursor:pointer}
